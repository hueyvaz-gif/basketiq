# Virtual mühit və keşlər - image-də yeri yoxdur
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# IDE
.idea/
.vscode/

# Sirlər: .env konteynerə env_file ilə verilir, image-ə YAZILMIR.
# Image registry-yə düşərsə, içindəki açar hamıya açıq olardı.
.env

# Yüklənmiş kataloqlar və baza - qalıcı volume-dadır (DATA_DIR), image-də yox.
# tessdata isə image-də QALMALIDIR, ona görə data/ tam istisna edilmir.
data/raw/
data/text/
data/cache/
data/*.db
data/*.png

# Yüklənən və yaradılan şəkillər image-ə DÜŞMÜR - konteynerdə onlar volume-dadır
# (MEDIA_DIR=/data/media). Image-ə düşsəydilər, eyni adlı volume faylını
# KÖLGƏLƏYƏRDİLƏR (`/static` əvvəl kod qovluğuna baxır, app/main.py): məsələn
# lokal `p12.jpg` serverdəki başqa məhsulun şəklinin yerinə çıxardı.
app/static/images/ads/*
!app/static/images/ads/sample-banner.svg
!app/static/images/ads/sample-rail.svg
app/static/product_images/
app/static/images/products/

# Git və sənədlər
.git/
.gitignore
*.md
!README.md
