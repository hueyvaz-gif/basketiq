.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.idea/
.vscode/

# Yüklənmiş kataloqlar və DB repo-ya düşmür
data/raw/*
data/text/*
data/*.db
data/*.db.bak-*
data/group_key_backup.json
!data/raw/.gitkeep
!data/text/.gitkeep

# LLM keşi generasiya olunur - repo-ya düşmür
data/cache/

# Kataloqdan kesilen mehsul sekilleri generasiya olunur (tools/build_images.py)
app/static/images/products/*
!app/static/images/products/.gitkeep

# Yuklenen reklam kreativleri generasiya olunur; numune banner repoda qalir
app/static/images/ads/*
!app/static/images/ads/sample-banner.svg
