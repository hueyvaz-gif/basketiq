.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.idea/
.vscode/

# Yüklənmiş kataloqlar və DB repo-ya düşmür
data/raw/*
data/text/*
data/*.db
data/*.db.bak-*
data/group_key_backup.json
!data/raw/.gitkeep
!data/text/.gitkeep

# LLM keşi generasiya olunur - repo-ya düşmür
data/cache/

# Market saytindan endirilen mehsul fotolari (M3). Repo-ya dusmur: onlar
# BIZIM deyil, menbe saytindandir - lisenziyasi bize aid olmayan fayli git
# tarixcesine daimi yazmaq dogru deyil. Berpa: python tools/product_images.py fetch
app/static/product_images/*
!app/static/product_images/.gitkeep

# Kataloqdan kesilen mehsul sekilleri generasiya olunur (tools/build_images.py)
app/static/images/products/*
!app/static/images/products/.gitkeep

# Yuklenen reklam kreativleri generasiya olunur; numune bannerler repoda qalir.
# sample-rail.svg burada yox idi - repoya dusmurdu, amma kod (app/ads.py) ve
# test ona istinad edir: temiz clone-da yan lovhe numunesi tapilmirdi.
app/static/images/ads/*
!app/static/images/ads/sample-banner.svg
!app/static/images/ads/sample-rail.svg

# Brauzer yoxlamasi ucun Playwright (Node). `package.json` REPODADIR - hansi
# alet ve hansi versiya isledildiyi qeyde alinmalidir; qovlugun ozu yox.
node_modules/

# Git worktree qovlugu: eyni reponun ikinci nusxesidir, ozu-ozunu saxlamamalidir.
.claude/worktrees/

# Dizayn skill paketi (16 MB ekran sekli) - alet paketidir, layihe menbeyi deyil.
trolley-design-design/
logs/morning.md
