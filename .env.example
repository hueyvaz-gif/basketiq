# Bu faylı kopyalayıb ".env" adı ilə saxla və dəyərləri doldur.
# .env HEÇ VAXT git-ə göndərilmir (.gitignore-da var).

# --- LLM ---
# Hansı model əsasdır?  ollama (defolt, pulsuz, yavaş) | claude (sürətli, ödənişli)
# claude seçilsə Ollama EHTİYAT olur: Claude qırılsa sorğu sükutla ona keçir.
# Açarı doldurandan sonra bunu `claude` yaz - əks halda açar olsa belə
# yalnız Ollama işlədilir.
LLM_PROVIDER=ollama

# Claude API açarı. https://console.anthropic.com -> API Keys
# Boş qalsa Claude işə düşmür və yalnız Ollama işlədilir.
ANTHROPIC_API_KEY=

# DİQQƏT: adlar LLM_ ilə başlayır, CLAUDE_ ilə YOX.
# Səbəb: bəzi mühitlərdə (məsələn Claude Code) CLAUDE_EFFORT artıq təyin
# olunub və bizim ayarımızı sükutla əvəz edirdi.
LLM_CLAUDE_MODEL=claude-opus-5
# Düşünmə dərinliyi: low | medium | high | xhigh | max
# Kataloq çıxarışı qısa JSON qaytarır - low kifayətdir və ucuzdur.
LLM_CLAUDE_EFFORT=low
LLM_CLAUDE_TIMEOUT_SECONDS=60
# Bir cavabın maksimum uzunluğu (TAVAN - real işlənmiş token qədər ödəyirik).
# Ollama-nın LLM_NUM_PREDICT-i burada işləmir: Claude-un "düşünmə" tokenləri də
# bu tavana daxildir, ona görə daha geniş verilir - yoxsa JSON yarımçıq kəsilir.
LLM_CLAUDE_MAX_TOKENS=4000

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Local dev-də quraşdırılmış model adını yaz (ollama list ilə bax).
# Production (DigitalOcean CPU droplet) üçün kiçik model: qwen3:4b və ya qwen3:8b
# Docker-də Ollama SEÇİMLİDİR (compose profili "ollama") - Claude əsasdırsa lazım deyil.
OLLAMA_MODEL=qwen3:4b
LLM_TEMPERATURE=0

# GPU olmayan noutbukda 4 paralel sorğu bütün nüvələri tutur və maşın donur.
# 1-2 saxla. Serverdə (DigitalOcean) artırmaq olar.
LLM_MAX_CONCURRENCY=2

# CPU inference yavaşdır - timeout səxavətli olsun
LLM_TIMEOUT_SECONDS=180

# Model bu müddətdən sonra RAM-dan boşalır (boş yerə 4GB tutmasın)
LLM_KEEP_ALIVE=60s
# İstifadə olunan CPU nüvəsi. 4 nüvəli maşında 3 qoy ki, sistem cavab versin.
LLM_NUM_THREAD=3
# Cavabın maksimum token sayı - model artıq danışmağa başlasa kəsilir
LLM_NUM_PREDICT=800

# --- App ---
APP_ENV=development

# Admin paneli (B11). Boş buraxılsa, APP_ENV-dən hesablanır:
# development -> açıq, production -> BAĞLI. İstehsalda açmaq üçün: ADMIN_ENABLED=1
# ADMIN_ENABLED=

# Reklam sayğacı (göstərim/klik). Boş buraxılsa, APP_ENV-dən hesablanır:
# development -> SAYILMIR (öz baxışların reklamverənin hesabatına yazılmasın),
# production -> sayılır. Lokalda sayğacı sınamaq üçün: ADS_COUNT=1
# ADS_COUNT=

# Reklam üçün əlaqə ünvanı (E20). Boş slotdakı «Reklam ver» düyməsi buraya
# yazır. TƏYİN EDİLMƏSƏ, düymə ümumiyyətlə göstərilmir - işləməyən keçid
# reklamverəni itirilmiş məktubla qoyar.
# ADS_CONTACT=reklam@example.az
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/basketiq.db

# Yazılan bütün fayllar (baza, xam kataloqlar, OCR mətni, LLM keşi) buranın
# altındadır. Lokalda boş buraxılır -> layihənin `data/` qovluğu.
# Docker-də: DATA_DIR=/data (qalıcı volume). Bax: deploy/README.md
DATA_DIR=

# Yüklənən/yaradılan şəkillər (reklam kreativi, məhsul fotosu, kataloq kəsiyi).
# Lokalda boş buraxılır -> `app/static` (fayllar kodun yanında).
# Docker-də MEDIA_DIR=/data/media (docker-compose.yml verir) - bazanın
# volume-u, yeniləmədə itmir. URL-lər dəyişmir (/static/...).
MEDIA_DIR=

# n8n -> FastAPI çağırışlarını qorumaq üçün. Production-da mütləq dəyiş.
INGEST_API_KEY=dev-secret-change-me

# --- OCR ---
# Windows-da Tesseract-ın tam yolu. Linux/Docker-də MÜTLƏQ boş olmalıdır -
# orada binary PATH-dədir və Windows yolu axtarılsa OCR qırılır.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGS=aze+eng+rus

# Dil faylları (aze/rus/tur) layihə daxilində saxlanılır - admin hüququ lazım deyil
TESSDATA_DIR=data/tessdata

# Səhifə seqmentasiya rejimi: 6=vahid blok, 4=sütunlu, 11=səpələnmiş mətn
OCR_PSM=6
# Skan səhifəni neçə dəfə böyüdək (2.0 ~ 144 DPI). Böyütmək dəqiqliyi artırır, sürəti azaldır.
OCR_SCALE=2.0
OCR_MAX_PAGES=20
# PDF-də bundan az mətn varsa skan sayılır və OCR işə düşür
PDF_TEXT_MIN_CHARS=200

# --- Layout analizi (kart tapan OCR) ---
# Qlyanslı kataloqda ad və qiymət ayrı bloklardadır; adi OCR onu oxuya bilmir.
LAYOUT_ENABLED=true
# Səhifədə bundan az kart tapılsa, adi OCR-a qayıdılır
LAYOUT_MIN_CARDS=3
# Render miqyası. 3.0 ölçülüb: 2.0-da qiymət rəqəmləri qarışır.
LAYOUT_SCALE=3.0
MAX_UPLOAD_MB=40

# --- Scraping ---
REQUEST_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=BasketIQ-Student-Project/1.0 (educational)

# Headless Chrome yolları (mağaza qatı - Wolt, gündəlik qiymətlər).
# Lokalda BOŞ: Selenium quraşdırılmış Chrome-u özü tapır. Docker-də Dockerfile
# verir (/usr/bin/chromium, /usr/bin/chromedriver) - burada yazmağa ehtiyac yoxdur.
# DİQQƏT: boş dəyərlə AÇIQ yazma - env_file ilə konteynerə düşüb Dockerfile-ın
# yolunu ezər. Lokalda başqa Chrome lazımdırsa, şərhi aç və yolu yaz:
# CHROME_BIN=
# CHROMEDRIVER_PATH=

# --- Telegram / Whisper (BONUS - hələ lazım deyil) ---
TELEGRAM_BOT_TOKEN=
WHISPER_MODEL=small
# tiny (~75 MB) / base (~145 MB) / small (~460 MB). Böyük model daha dəqiqdir,
# amma GPU-suz maşında yavaşdır. Ölçülüb: small ilə 3.4 san səs -> 11 san emal.

# Regex əmri tanımayanda LLM işə düşsünmü? Ölçülüb: 10-35 saniyə əlavə edir.
VOICE_LLM_FALLBACK=true

# --- MEHSUL SEKILLERI (M3) ---
# Etibar esiyi: bu baldan asagi uygunluq REDD edilir ve mehsul kateqoriya
# ikonunda qalir. "Sehv sekildense ikon yaxsidir" - defolt qesden yuksekdir.
# Sehv sekil gorsen, ASAGI SALMA, YUXARI qaldir.
# PRODUCT_IMAGE_MIN_CONFIDENCE=0.75

# Iki namized arasindaki ferq bundan azdirsa, secim tesadufe cevrilir - redd.
# PRODUCT_IMAGE_AMBIGUITY_GAP=0.05

# Nezaket: saniyede bir sorgu. Kicikletmek menbe sayta yuk salir.
# PRODUCT_IMAGE_DELAY_SECONDS=1.0
# PRODUCT_IMAGE_TIMEOUT=10
# PRODUCT_IMAGE_MAX_BYTES=5242880
# PRODUCT_IMAGE_MAX_SIDE=600
